  "dimensions": [
    {
      "id": "survival",
      "name": "生存",
      "question": "怎么活下去？",
      "oneliner": "当下存续的稳定性保障"
    },
    {
      "id": "reproduction",
      "name": "繁衍",
      "question": "怎么传下去？",
      "oneliner": "未来存续的可能性拓展"
    },
    {
      "id": "rebellion",
      "name": "逆反",
      "question": "路径僵化时怎么改？",
      "oneliner": "对既有路径的反思、质疑与突破"
    },
    {
      "id": "interest",
      "name": "利益",
      "question": "谁在争什么？",
      "oneliner": "多维利益驱动行为与制度变迁"
    }
  ],
  "concept_pool": [
    {
      "id": "survival_three_dimensions",
      "name": "物质/社会/精神三维度",
      "dimension": "生存",
      "oneliner": "生存不止温饱，还有身份和意义",
      "typical_use": "个体或群体在哪一层'活不下去'"
    },
    {
      "id": "cost_benefit",
      "name": "成本-收益核算",
      "dimension": "生存",
      "oneliner": "投入大于回报的持续失衡",
      "typical_use": "谁在一直亏、亏什么、亏了多久"
    },
    {
      "id": "compensation",
      "name": "代偿",
      "dimension": "生存",
      "oneliner": "用A维度的过度付出来弥补B维度的亏空",
      "typical_use": "明知不对却停不下来的行为"
    },
    {
      "id": "alienation",
      "name": "异化",
      "dimension": "生存",
      "oneliner": "代偿固化后自我与行为脱节",
      "typical_use": "'我已经不是我了'的状态"
    },
    {
      "id": "phase_transition",
      "name": "相变",
      "dimension": "生存",
      "oneliner": "量变积累到临界点后质变",
      "typical_use": "突然崩溃、突然爆发、突然翻转"
    },
    {
      "id": "reproduction_temporality",
      "name": "复制性/变异性/时间性",
      "dimension": "繁衍",
      "oneliner": "传递什么、怎么变、窗口多长",
      "typical_use": "传承、扩散、传播、制度延续"
    },
    {
      "id": "four_carriers",
      "name": "四载体",
      "dimension": "繁衍",
      "oneliner": "生物/文化/制度/技术四种传递载体",
      "typical_use": "哪种载体在起作用、哪种失效"
    },
    {
      "id": "three_survival_boundaries",
      "name": "三存续边界",
      "dimension": "繁衍",
      "oneliner": "传递能撑多久",
      "typical_use": "传统为何断裂、制度为何僵化"
    },
    {
      "id": "three_natures",
      "name": "三性质（建设/消极/破坏）",
      "dimension": "逆反",
      "oneliner": "逆反的结果是修还是毁",
      "typical_use": "抗议、躺平、暴力对抗的性质判断"
    },
    {
      "id": "five_types",
      "name": "五类型（主动/被动/自发/协从/主导）",
      "dimension": "逆反",
      "oneliner": "谁在反、怎么反",
      "typical_use": "个体觉醒 vs 群体裹挟"
    },
    {
      "id": "activation_threshold",
      "name": "激活阈值",
      "dimension": "逆反",
      "oneliner": "压死骆驼的最后一根稻草",
      "typical_use": "什么事触发了逆反、为什么是这件事"
    },
    {
      "id": "rebellion_disability",
      "name": "逆反失能",
      "dimension": "逆反",
      "oneliner": "该反没反、反了没用",
      "typical_use": "沉默的大多数、制度化的无力"
    },
    {
      "id": "gunpowder_effect",
      "name": "火药桶效应",
      "dimension": "逆反",
      "oneliner": "积压→引爆→反噬",
      "typical_use": "群体性事件、网络暴力、集体宣泄"
    },
    {
      "id": "six_interest_types",
      "name": "六大利益类型",
      "dimension": "利益",
      "oneliner": "物质/安全/政治/身份文化/制度性未来/公共利益",
      "typical_use": "谁在争什么"
    },
    {
      "id": "interest_conversion_paths",
      "name": "利益转化路径",
      "dimension": "利益",
      "oneliner": "政治权力→经济收益→文化影响力……",
      "typical_use": "A如何变成B"
    },
    {
      "id": "interest_flow",
      "name": "利益动线",
      "dimension": "利益",
      "oneliner": "经济/权力/文化/法律四路径追踪",
      "typical_use": "资源从哪来、流向谁、谁卡住"
    },
    {
      "id": "narrative_battlefield",
      "name": "叙事战场",
      "dimension": "利益",
      "oneliner": "谁控制了'真相定义权'",
      "typical_use": "信息操纵、舆论引导、选择性公开"
    },
    {
      "id": "four_historical_dynamics",
      "name": "四大历史动力机制",
      "dimension": "利益",
      "oneliner": "激励-约束/嵌入-制度化/合法化-叙事化/连锁-外溢",
      "typical_use": "短期如何变长期、局部如何扩散"
    },
    {
      "id": "triadic_mutual_construction",
      "name": "三元互构关系",
      "dimension": "利益",
      "oneliner": "生存-繁衍-逆反三维度互为因果",
      "typical_use": "维度间的联动放大效应"
    },
    {
      "id": "three_point_framework",
      "name": "三点式框架",
      "dimension": "通用",
      "oneliner": "A持存/B延伸/C偏离与重构",
      "typical_use": "抽象分析、不想贴维度标签时"
    }
  ],
  "max_concepts": 3,
  "max_concepts_special": 4,
  "interest_types": [
    {
      "id": "material",
      "name": "物质利益",
      "features": [
        "稀缺性",
        "可分割性",
        "可控制性"
      ],
      "key_question": "谁控制「抓—运—分—护—续」链条的哪个节点？谁卡住了瓶颈？"
    },
    {
      "id": "security",
      "name": "安全利益",
      "features": [
        "防御性",
        "优先性",
        "生存底线"
      ],
      "key_question": "安全措施是真实防御还是利益转移的掩护？约束了谁、保护了谁？"
    },
    {
      "id": "political",
      "name": "政治利益",
      "features": [
        "枢纽性",
        "可转化性",
        "规则制定权"
      ],
      "key_question": "谁掌握水渠（资源分配渠道）？制度优势是否已路径依赖？"
    },
    {
      "id": "identity_culture",
      "name": "身份与文化利益",
      "features": [
        "动员力强",
        "超越理性计算"
      ],
      "key_question": "身份认同如何被激活为集体行动？符号如何成为资本？"
    },
    {
      "id": "institutional_future",
      "name": "制度性与未来利益",
      "features": [
        "时间延迟",
        "规则固化",
        "代际影响"
      ],
      "key_question": "当前制度选择将在多远未来显现影响？后来者有无翻盘空间？"
    },
    {
      "id": "public",
      "name": "公共利益",
      "features": [
        "非排他性",
        "共识依赖"
      ],
      "key_question": "谁在定义「公共利益」和「违反公共利益」？叙事边界如何被争夺？"
    }
  ],
  "interest_conversion_paths": [
    "政治权力→经济收益",
