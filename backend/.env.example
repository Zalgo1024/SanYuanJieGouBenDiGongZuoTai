# ── 域引擎目录 ──
# 默认已指向发现的路径；如果移动了域引擎代码，改这里即可。
ENGINE_DIR=D:\360MoveData\Users\马格斯佩斯科夫\Desktop\人类主义\三元结构理论\三元结构理论 分析skill脚本程序

# ── LLM 配置 ──
# 不填 OPENAI_API_KEY 时，后端自动使用 MockClient：
# 输入→报告 管线依然能跑通（证明集成契约），但正文是占位内容。
# 填入后，generator 会真正调用模型按 analysis_prompt.md 生成分析。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

# ── 生成报告输出目录 ──
GENERATED_DIR=generated

# ── 联网检索（T1，可选）──
# 默认使用 DuckDuckGo HTML 免费源（零 Key）；配置以下任一 Key 后自动升级官方 API：
# BING_SEARCH_KEY 优先，其次 BRAVE_SEARCH_KEY，均未配置时回退 DDG。
# 密钥只进 backend/.env / 环境变量，绝不写入代码或前端。
BING_SEARCH_KEY=
BRAVE_SEARCH_KEY=
